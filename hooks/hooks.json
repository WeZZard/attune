{
  "description": "Attune execution-guidelines injection — Claude-only, carries no porting.json listing",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-execution.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
